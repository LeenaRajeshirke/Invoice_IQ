# Set these in the backend process environment. Never expose them as VITE_ variables.
N8N_INVOICE_WEBHOOK_URL=http://localhost:5678/webhook/replace-with-your-workflow-webhook
N8N_INVOICE_WEBHOOK_SECRET=replace-with-your-n8n-header-auth-secret

# Frontend development settings
VITE_API_MODE=live
VITE_API_BASE_URL=http://localhost:8000
VITE_MAX_UPLOAD_MB=10
